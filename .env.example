# Fayzee E-Commerce Platform Environment Configuration Example

# For SQLite local development:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production deployment (e.g. Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/fayzee?schema=public"

# Auth secrets
JWT_SECRET="your-super-secret-jwt-token-key-at-least-32-characters"
AUTH_SECRET="your-cookie-session-secret-key"

# App URL (On Vercel, set to your live production domain: https://fayzee.store)
NEXT_PUBLIC_APP_URL="https://fayzee.store"

# Email Provider Configuration (Resend - https://resend.com)
# 1. Create a free account at https://resend.com and generate an API key (starts with re_...)
# 2. Add RESEND_API_KEY to your Vercel Project Environment Variables.
# 3. For testing before domain verification, use: EMAIL_FROM="FAYZEE <onboarding@resend.dev>"
#    (Note: onboarding@resend.dev can send emails to the email address registered with your Resend account).
# 4. Once your domain fayzee.store is verified in Resend DNS, set: EMAIL_FROM="FAYZEE <no-reply@fayzee.store>"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="FAYZEE <onboarding@resend.dev>"

# Google Gemini AI API Key
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"

# Image Storage Provider
# By default, FAYZEE stores validated uploads securely in local Next.js static storage: public/uploads/products/
# No external cloud keys are required for standard operation.
# If deploying to a serverless platform without persistent filesystem (e.g. Vercel), configure an external S3/Cloudinary bucket:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# AWS_S3_BUCKET_NAME=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Payment Gateway Secrets (Stripe / PayFast / JazzCash / EasyPaisa)
PAYMENT_SECRET_KEY="sk_test_..."
PAYMENT_WEBHOOK_SECRET="whsec_..."

# Platform Currency
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_CURRENCY_CODE="PKR"

