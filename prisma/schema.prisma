// Fayzee Multi-Vendor E-Commerce Platform
// Prisma Schema - Unified & Production-Ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  role          String    @default("CUSTOMER") // CUSTOMER, SELLER, ADMIN, SUPER_ADMIN
  status        String    @default("ACTIVE")   // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sellerProfile SellerProfile?
  applications  SellerApplication[]
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cart          Cart?
  wishlist      Wishlist?
  notifications Notification[]
  conversations AIConversation[]
  recentlyViewed RecentlyViewed[]
  auditLogs     AuditLog[]
  couponUsages  CouponUsage[]
  passwordResets PasswordReset[]
  followingSellers SellerFollow[] @relation("UserFollowedSellers")
  customerChats    SellerChatConversation[] @relation("CustomerSellerChats")


  @@index([email])
  @@index([role])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home") // Home, Office, Other
  fullName    String
  phone       String
  street      String
  city        String
  state       String
  postalCode  String
  country     String   @default("Pakistan")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SellerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  storeName       String
  storeSlug       String   @unique
  description     String?
  logoUrl         String?
  bannerUrl       String?
  taxNumber       String?
  cnic            String?
  address         String?
  phone           String?
  commissionRate  Float    @default(10.0) // 10%
  rating          Float    @default(0.0)
  reviewCount     Int      @default(0)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  rejectionReason String?
  isPhoneVerified Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  cnicFrontUrl    String?
  cnicBackUrl     String?
  bankProofUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Bank & Payout Receiving Details
  bankName        String?
  accountTitle    String?
  accountNumber   String?
  iban            String?
  branchCode      String?
  payoutMethod    String   @default("BANK_TRANSFER") // BANK_TRANSFER, JAZZ_CASH, EASYPAISA
  payoutPhone     String?

  products        Product[]
  orderItems      OrderItem[]
  payouts         SellerPayout[]
  followers         SellerFollow[]           @relation("SellerFollowers")
  chatConversations SellerChatConversation[] @relation("SellerChatConversations")

  @@index([storeSlug])
  @@index([status])
}

model SellerApplication {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String
  storeName           String
  businessAddress     String
  taxNumber           String?
  cnic                String
  phone               String
  email               String?
  isPhoneVerified     Boolean   @default(false)
  isEmailVerified     Boolean   @default(false)
  cnicFrontUrl        String?
  cnicBackUrl         String?
  bankProofUrl        String?
  documentUrl         String?
  phoneOtp            String?
  phoneOtpExpires     DateTime?
  emailOtp            String?
  emailOtpExpires     DateTime?
  notes               String?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  image       String?
  icon        String?
  parentId    String?
  parent      Category?     @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]    @relation("SubCategories")
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories Subcategory[]
  products      Product[]

  @@index([slug])
  @@index([parentId])
}

model Subcategory {
  id          String        @id @default(cuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  image       String?
  icon        String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  productTypes ProductType[]
  products     Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
}

model ProductType {
  id            String      @id @default(cuid())
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String?
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products      Product[]

  @@unique([subcategoryId, slug])
  @@index([subcategoryId])
  @@index([slug])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id               String          @id @default(cuid())
  sellerId         String
  seller           SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  subcategoryId    String?
  subcategory      Subcategory?    @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  productTypeId    String?
  productType      ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  brandId          String?
  brand            Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  
  title            String
  slug             String          @unique
  shortDescription String?
  description      String
  sku              String          @unique
  price            Float
  salePrice        Float?
  discountPercent  Float?          @default(0)
  stockQuantity    Int             @default(0)
  
  status           String          @default("ACTIVE") // ACTIVE, DRAFT, OUT_OF_STOCK, ARCHIVED
  isFeatured       Boolean         @default(false)
  isTrending       Boolean         @default(false)
  rating           Float           @default(0.0)
  reviewCount      Int             @default(0)
  
  weight           Float?          // in kg
  dimensions       String?         // LxWxH
  shippingFee      Float           @default(0.0)
  warrantyInfo     String?
  specifications   String?         // JSON string: {"RAM":"8GB","Storage":"256GB"}
  attributes       String?         // Dynamic category attributes JSON: {"Brand":"Apple","Color":"Silver","RAM":"8GB"}
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  images           ProductImage[]
  variants         ProductVariant[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  flashSaleItems   FlashSaleItem[]
  recentlyViewed   RecentlyViewed[]

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([productTypeId])
  @@index([brandId])
  @@index([sellerId])
  @@index([status])
  @@index([price])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  isThumbnail Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String      // e.g. "8GB / 256GB / Midnight Black"
  sku           String      @unique
  color         String?     // e.g. "Midnight Black"
  size          String?     // e.g. "256GB" or "XL"
  price         Float
  salePrice     Float?
  stockQuantity Int         @default(0)
  attributes    String?     // JSON string e.g. {"RAM":"8GB","Storage":"256GB","Color":"Midnight Black"}
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([sku])
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  items        CartItem[]

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  
  subtotal        Float
  discountTotal   Float       @default(0.0)
  shippingTotal   Float       @default(0.0)
  taxTotal        Float       @default(0.0)
  grandTotal      Float
  
  status          String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURN_REQUESTED, RETURNED, REFUNDED
  paymentStatus   String      @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, REFUNDED, CANCELLED
  paymentMethod   String      @default("COD")     // COD, ONLINE_CARD, WALLET
  
  shippingAddress String      // JSON string snapshot of delivery address
  notes           String?
  trackingNumber  String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payments        Payment[]
  couponUsages    CouponUsage[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sellerId          String
  seller            SellerProfile   @relation(fields: [sellerId], references: [id])
  
  title             String
  sku               String
  price             Float
  quantity          Int
  total             Float
  fulfillmentStatus String          @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   String   // COD, ONLINE_CARD
  transactionId   String?  @unique
  amount          Float
  currency        String   @default("PKR")
  status          String   @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, REFUNDED, CANCELLED
  gatewayResponse String?  // JSON string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([transactionId])
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      @default(5)
  title              String?
  comment            String
  images             String?  // JSON string array of image URLs
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(true)
  sellerResponse     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  description       String?
  discountType      String        @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue     Float
  minOrderAmount    Float         @default(0.0)
  maxDiscountAmount Float?
  usageLimit        Int           @default(100)
  usedCount         Int           @default(0)
  perUserLimit      Int           @default(1)
  startDate         DateTime      @default(now())
  endDate           DateTime
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  usages            CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Float
  usedAt         DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([userId])
}

model FlashSale {
  id          String          @id @default(cuid())
  title       String
  description String?
  bannerImage String?
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       FlashSaleItem[]

  @@index([isActive])
  @@index([startTime, endTime])
}

model FlashSaleItem {
  id            String    @id @default(cuid())
  flashSaleId   String
  flashSale     FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPrice Float
  stockLimit    Int       @default(10)
  soldCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([flashSaleId, productId])
  @@index([flashSaleId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // ORDER, SELLER, PROMOTION, SYSTEM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AIConversation {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?
  title        String      @default("Shopping Chat")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages     AIMessage[]

  @@index([userId])
  @@index([sessionToken])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // USER, ASSISTANT, SYSTEM
  content        String
  metadata       String?        // JSON string with product cards, comparisons, actions
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

model RecentlyViewed {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt     DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // SELLER_APPROVED, PRODUCT_MODERATED, ORDER_STATUS_UPDATED, etc.
  targetType String   // USER, SELLER, PRODUCT, ORDER, COUPON
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model SellerPayout {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount          Float
  fee             Float         @default(0.0)
  netAmount       Float
  status          String        @default("PENDING") // PENDING, TRANSFERRED, REJECTED
  payoutMethod    String        // BANK_TRANSFER, JAZZ_CASH, EASYPAISA
  payoutDetails   String?       // JSON string of snapshot bank / wallet details at request time
  adminReference  String?       // Bank transaction ref / UTR / Cheque entered by Admin
  rejectionReason String?
  requestedAt     DateTime      @default(now())
  processedAt     DateTime?
  processedBy     String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sellerId])
  @@index([status])
}

model PlatformFinancialSetting {
  id                    String   @id @default("default")
  defaultCommissionRate Float    @default(10.0) // 10%
  minPayoutAmount       Float    @default(1000.0) // Rs. 1,000 minimum withdrawal
  adminBankName         String?  // e.g. Habib Bank Limited (HBL)
  adminAccountTitle     String?  // e.g. FAYZEE MARKETPLACE (PVT) LTD
  adminAccountNumber    String?
  adminIban             String?
  adminBranchCode       String?
  adminJazzCash         String?  // e.g. 03001234567
  adminEasyPaisa        String?  // e.g. 03451234567
  payoutInstructions    String?
  updatedAt             DateTime @updatedAt
}

model PlatformCourierSetting {
  id                String   @id @default("default")
  activeProvider    String   @default("POSTEX") // POSTEX, TRAX, TCS, MANUAL
  isSandbox         Boolean  @default(true)      // true = Test Mode, false = Live Production Mode
  postexApiToken    String?
  traxApiKey        String?
  tcsUsername       String?
  tcsPassword       String?
  tcsCostCenterCode String?
  defaultPickupCity String   @default("Karachi")
  webhookSecret     String?
  updatedAt         DateTime @updatedAt
}

model SellerFollow {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("UserFollowedSellers", fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, sellerId])
  @@index([userId])
  @@index([sellerId])
}

model SellerChatConversation {
  id            String              @id @default(cuid())
  customerId    String
  customer      User                @relation("CustomerSellerChats", fields: [customerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        SellerProfile       @relation("SellerChatConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  messages      SellerChatMessage[]

  @@unique([customerId, sellerId])
  @@index([customerId])
  @@index([sellerId])
  @@index([lastMessageAt])
}

model SellerChatMessage {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   SellerChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     String                 // CUSTOMER, SELLER
  content        String
  isRead         Boolean                @default(false)
  createdAt      DateTime               @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model PlatformPaymentSetting {
  id                   String   @id @default("default")
  activeGateway        String   @default("SAFEPAY") // SAFEPAY, PAYFAST, JAZZCASH, MANUAL_SIMULATION
  isSandbox            Boolean  @default(true)      // true = Test Mode, false = Live Production Mode
  safepayApiKey        String?
  safepayApiSecret     String?
  safepayWebhookSecret String?
  payfastMerchantId    String?
  payfastSecuredKey    String?
  enableCod            Boolean  @default(true)
  enableOnlineCard     Boolean  @default(true)
  enableJazzcash       Boolean  @default(true)
  enableEasypaisa      Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  name        String
  email       String
  phone       String?
  orderNumber String?
  category    String
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ticketId])
  @@index([status])
  @@index([email])
}

